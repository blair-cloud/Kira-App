{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix Frontend",
  "buildCommand": "npm run build:demo --prefix Frontend",
  "outputDirectory": "Frontend/dist",
  "rewrites": [
    { "source": "/((?!assets/|images/).*)", "destination": "/index.html" }
  ]
}
