APP_ENV=development
# SQLite is for local development/tests only; production requires Supabase PostgreSQL.
DATABASE_URL=sqlite:///./kira.db
# Use the Supabase session pooler URL with psycopg. URL-encode password characters.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only. Required only for provisioning users/demo accounts.
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
AUTH_REDIRECT_URL=http://127.0.0.1:5173/auth/callback
ENABLE_DEMO_ACCOUNTS=false
# Set this to your development Supabase project URL to allow demo seeding there.
DEMO_PROJECT_URL=
RETENTION_DAYS=365
REPORT_MIN_GROUP_SIZE=5
UPLOAD_MAX_BYTES=2097152
