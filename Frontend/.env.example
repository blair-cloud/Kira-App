# Browser-only mock role preview; no backend, database, or Supabase required.
# Use supabase when you are ready to enable connected authentication.
VITE_AUTH_MODE=mock
VITE_API_URL=/api/v1
# Public client values only. Never put a service-role key or database password here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Visible only in a Vite development build AND when the backend demo flag is enabled.
VITE_ENABLE_DEMO_LOGIN=false
# Optional local mock access. Honored only by the development server.
VITE_ENABLE_LOCAL_DEMO=false
